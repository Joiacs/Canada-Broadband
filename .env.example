# ---------------------------------------------------------------------------
# Copy to .env.local for local development. In production set these in
# Vercel (app) and GitHub Actions secrets (pipeline). Never commit real values.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres + PostGIS) ---------------------------------
# App: use Supabase's *transaction pooler* URL (port 6543) in production.
# Local: postgresql://postgres:postgres@127.0.0.1:55322/postgres
DATABASE_URL=
# Pipeline (optional): direct/session connection (port 5432) for long jobs.
# Falls back to DATABASE_URL when empty.
PIPELINE_DATABASE_URL=

# Secret used to hash IP addresses (app + pipeline must use the SAME value).
# Generate with: openssl rand -base64 32
IP_HASH_SALT=

# --- Public site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where boundaries.pmtiles is served from (folder URL, no trailing slash).
# Local: /tiles   Production: e.g. https://tiles.your-domain.ca
NEXT_PUBLIC_TILES_URL=/tiles
# Optional basemap overrides (MapLibre style URLs). Defaults: OpenFreeMap.
NEXT_PUBLIC_BASEMAP_LIGHT=
NEXT_PUBLIC_BASEMAP_DARK=

# --- Cloudflare Turnstile (bot protection on speed-test submissions) --------
# These are Cloudflare's always-pass TEST keys. Replace in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Pipeline: M-Lab via BigQuery -------------------------------------------
# Google Cloud project used for BigQuery query billing.
GCP_PROJECT_ID=
# Safety limit per BigQuery query (GB scanned).
MLAB_MAX_GB_PER_QUERY=60
# Days re-imported each night (M-Lab publishes with a 1–2 day lag).
MLAB_LOOKBACK_DAYS=4
# Raw M-Lab rows are deleted after this many days (aggregates are kept forever
# and raw rows can always be re-downloaded from BigQuery). Must stay > 10 so
# community tests can be verified. Use 10–14 on Supabase's free plan.
RAW_RETENTION_DAYS=21
# Override if M-Lab renames its views.
MLAB_DOWNLOAD_VIEW=
MLAB_UPLOAD_VIEW=
